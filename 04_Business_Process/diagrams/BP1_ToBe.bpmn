<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP1_ToBe" targetNamespace="https://github.com/taint7684/hl-oms-ba">
  <bpmn:collaboration id="Col_BP1_ToBe">
    <bpmn:participant id="Pool_BP1_ToBe" name="BP1 To-Be · Gọi món tại bàn (HL-OMS)" processRef="BP1_ToBe"/>
  </bpmn:collaboration>
  <bpmn:process id="BP1_ToBe" isExecutable="false">
    <bpmn:laneSet id="LS_BP1_ToBe">
      <bpmn:lane id="Lane_BP1_ToBe_K" name="Khách">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP1_ToBe_W" name="Phục vụ">
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP1_ToBe_S" name="HL-OMS">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP1_ToBe_B" name="Bếp">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách ngồi vào bàn"><bpmn:outgoing>F_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="w1" name="Mở bàn, nhập số khách"><bpmn:incoming>F_0</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="k1" name="Gọi món"><bpmn:incoming>F_1</bpmn:incoming><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="w2" name="Chọn món, tùy chọn, ghi chú"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s1" name="Kiểm tra còn món, số phần (BR-01)"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Còn món?"><bpmn:incoming>F_4</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="w3" name="Khai báo dị ứng (nếu có)"><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="w5" name="Báo khách chọn món khác"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="w4" name="Bấm Gửi bếp"><bpmn:incoming>F_8</bpmn:incoming><bpmn:outgoing>F_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s2" name="Chia món theo trạm, trừ số phần (BR-03, BR-07)"><bpmn:incoming>F_9</bpmn:incoming><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="b1" name="Nhận đơn trên KDS ≤ 2 giây"><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e1" name="Sang BP2"><bpmn:incoming>F_11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_0" sourceRef="s" targetRef="w1"/>
    <bpmn:sequenceFlow id="F_1" sourceRef="w1" targetRef="k1"/>
    <bpmn:sequenceFlow id="F_2" sourceRef="k1" targetRef="w2"/>
    <bpmn:sequenceFlow id="F_3" sourceRef="w2" targetRef="s1"/>
    <bpmn:sequenceFlow id="F_4" sourceRef="s1" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_5" sourceRef="g1" targetRef="w3" name="Còn"/>
    <bpmn:sequenceFlow id="F_6" sourceRef="g1" targetRef="w5" name="Hết"/>
    <bpmn:sequenceFlow id="F_7" sourceRef="w5" targetRef="k1" name="Gọi lại"/>
    <bpmn:sequenceFlow id="F_8" sourceRef="w3" targetRef="w4"/>
    <bpmn:sequenceFlow id="F_9" sourceRef="w4" targetRef="s2"/>
    <bpmn:sequenceFlow id="F_10" sourceRef="s2" targetRef="b1"/>
    <bpmn:sequenceFlow id="F_11" sourceRef="b1" targetRef="e1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_BP1_ToBe">
    <bpmndi:BPMNPlane id="Pl_BP1_ToBe" bpmnElement="Col_BP1_ToBe">
      <bpmndi:BPMNShape id="S_Pool_BP1_ToBe" bpmnElement="Pool_BP1_ToBe" isHorizontal="true"><dc:Bounds x="30" y="30" width="1718" height="575"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_ToBe_K" bpmnElement="Lane_BP1_ToBe_K" isHorizontal="true"><dc:Bounds x="64" y="30" width="1684" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_ToBe_W" bpmnElement="Lane_BP1_ToBe_W" isHorizontal="true"><dc:Bounds x="64" y="150" width="1684" height="215"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_ToBe_S" bpmnElement="Lane_BP1_ToBe_S" isHorizontal="true"><dc:Bounds x="64" y="365" width="1684" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_ToBe_B" bpmnElement="Lane_BP1_ToBe_B" isHorizontal="true"><dc:Bounds x="64" y="485" width="1684" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="155" y="72" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w1" bpmnElement="w1"><dc:Bounds x="265" y="179" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_k1" bpmnElement="k1"><dc:Bounds x="415" y="59" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w2" bpmnElement="w2"><dc:Bounds x="565" y="179" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s1" bpmnElement="s1"><dc:Bounds x="715" y="394" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g1" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="900" y="402" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w3" bpmnElement="w3"><dc:Bounds x="1015" y="179" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w5" bpmnElement="w5"><dc:Bounds x="865" y="274" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w4" bpmnElement="w4"><dc:Bounds x="1165" y="179" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s2" bpmnElement="s2"><dc:Bounds x="1315" y="394" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_b1" bpmnElement="b1"><dc:Bounds x="1465" y="514" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_e1" bpmnElement="e1"><dc:Bounds x="1655" y="527" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_0" bpmnElement="F_0"><di:waypoint x="191" y="90"/><di:waypoint x="247" y="90"/><di:waypoint x="247" y="210"/><di:waypoint x="265" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_1" bpmnElement="F_1"><di:waypoint x="381" y="210"/><di:waypoint x="397" y="210"/><di:waypoint x="397" y="90"/><di:waypoint x="415" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_2" bpmnElement="F_2"><di:waypoint x="531" y="90"/><di:waypoint x="547" y="90"/><di:waypoint x="547" y="210"/><di:waypoint x="565" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_3" bpmnElement="F_3"><di:waypoint x="681" y="210"/><di:waypoint x="697" y="210"/><di:waypoint x="697" y="425"/><di:waypoint x="715" y="425"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_4" bpmnElement="F_4"><di:waypoint x="831" y="425"/><di:waypoint x="900" y="425"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_5" bpmnElement="F_5"><di:waypoint x="946" y="425"/><di:waypoint x="997" y="425"/><di:waypoint x="997" y="210"/><di:waypoint x="1015" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_6" bpmnElement="F_6"><di:waypoint x="923" y="402"/><di:waypoint x="923" y="336"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_7" bpmnElement="F_7"><di:waypoint x="865" y="305"/><di:waypoint x="473" y="305"/><di:waypoint x="473" y="121"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_8" bpmnElement="F_8"><di:waypoint x="1131" y="210"/><di:waypoint x="1165" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_9" bpmnElement="F_9"><di:waypoint x="1281" y="210"/><di:waypoint x="1297" y="210"/><di:waypoint x="1297" y="425"/><di:waypoint x="1315" y="425"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_10" bpmnElement="F_10"><di:waypoint x="1431" y="425"/><di:waypoint x="1447" y="425"/><di:waypoint x="1447" y="545"/><di:waypoint x="1465" y="545"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_11" bpmnElement="F_11"><di:waypoint x="1581" y="545"/><di:waypoint x="1655" y="545"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
