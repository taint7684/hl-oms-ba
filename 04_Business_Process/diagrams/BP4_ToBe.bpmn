      <bpmndi:BPMNShape id="S_e2" bpmnElement="e2"><dc:Bounds x="1355" y="407" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w3" bpmnElement="w3"><dc:Bounds x="1165" y="489" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g3" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="1500" y="282" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s3" bpmnElement="s3"><dc:Bounds x="1615" y="274" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_m1" bpmnElement="m1"><dc:Bounds x="1615" y="609" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s4" bpmnElement="s4"><dc:Bounds x="1765" y="274" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_e3" bpmnElement="e3"><dc:Bounds x="1955" y="287" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_0" bpmnElement="F_0"><di:waypoint x="191" y="90"/><di:waypoint x="265" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_1" bpmnElement="F_1"><di:waypoint x="381" y="90"/><di:waypoint x="397" y="90"/><di:waypoint x="397" y="210"/><di:waypoint x="415" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_2" bpmnElement="F_2"><di:waypoint x="531" y="210"/><di:waypoint x="600" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_3" bpmnElement="F_3"><di:waypoint x="646" y="210"/><di:waypoint x="755" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_4" bpmnElement="F_4"><di:waypoint x="623" y="233"/><di:waypoint x="623" y="305"/><di:waypoint x="715" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_5" bpmnElement="F_5"><di:waypoint x="831" y="305"/><di:waypoint x="847" y="305"/><di:waypoint x="847" y="425"/><di:waypoint x="865" y="425"/></bpmndi:BPMNEdge>
