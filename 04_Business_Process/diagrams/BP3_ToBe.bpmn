<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP3_ToBe" targetNamespace="https://github.com/taint7684/hl-oms-ba">
  <bpmn:collaboration id="Col_BP3_ToBe">
    <bpmn:participant id="Pool_BP3_ToBe" name="BP3 To-Be · Thanh toán (HL-OMS)" processRef="BP3_ToBe"/>
  </bpmn:collaboration>
  <bpmn:process id="BP3_ToBe" isExecutable="false">
    <bpmn:laneSet id="LS_BP3_ToBe">
      <bpmn:lane id="Lane_BP3_ToBe_K" name="Khách">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP3_ToBe_C" name="Thu ngân">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP3_ToBe_S" name="HL-OMS">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP3_ToBe_M" name="Quản lý">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách xin tính tiền"><bpmn:outgoing>F_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="c1" name="Mở bill của bàn"><bpmn:incoming>F_0</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s1" name="Tính tạm tính, phụ thu lễ, GST (BR-09, BR-10)"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Tách bill?"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="c2" name="Tách theo món hoặc chia đều (BR-14)"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>F_4</bpmn:incoming><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Giảm giá?"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing><bpmn:outgoing>F_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g4" name="Vượt 10%?"><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_9</bpmn:outgoing><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="c3" name="Áp giảm giá"><bpmn:incoming>F_9</bpmn:incoming><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="m1" name="Duyệt giảm giá (BR-11)"><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g5" name=""><bpmn:incoming>F_8</bpmn:incoming><bpmn:incoming>F_11</bpmn:incoming><bpmn:incoming>F_12</bpmn:incoming><bpmn:outgoing>F_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="k1" name="Xác nhận bill"><bpmn:incoming>F_13</bpmn:incoming><bpmn:outgoing>F_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="k2" name="Thanh toán EFTPOS / tiền mặt"><bpmn:incoming>F_14</bpmn:incoming><bpmn:outgoing>F_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="c4" name="Ghi nhận phương thức, số tiền, in hóa đơn"><bpmn:incoming>F_15</bpmn:incoming><bpmn:outgoing>F_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s2" name="Đóng bill, bàn chuyển Cần dọn (BR-17)"><bpmn:incoming>F_16</bpmn:incoming><bpmn:outgoing>F_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Đã thanh toán"><bpmn:incoming>F_17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_0" sourceRef="s" targetRef="c1"/>
    <bpmn:sequenceFlow id="F_1" sourceRef="c1" targetRef="s1"/>
    <bpmn:sequenceFlow id="F_2" sourceRef="s1" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_3" sourceRef="g1" targetRef="c2" name="Có"/>
    <bpmn:sequenceFlow id="F_4" sourceRef="g1" targetRef="g2" name="Không"/>
    <bpmn:sequenceFlow id="F_5" sourceRef="c2" targetRef="g2"/>
    <bpmn:sequenceFlow id="F_6" sourceRef="g2" targetRef="g3"/>
    <bpmn:sequenceFlow id="F_7" sourceRef="g3" targetRef="g4" name="Có"/>
    <bpmn:sequenceFlow id="F_8" sourceRef="g3" targetRef="g5" name="Không"/>
    <bpmn:sequenceFlow id="F_9" sourceRef="g4" targetRef="c3" name="≤ 10%"/>
    <bpmn:sequenceFlow id="F_10" sourceRef="g4" targetRef="m1" name="&gt; 10%"/>
    <bpmn:sequenceFlow id="F_11" sourceRef="c3" targetRef="g5"/>
    <bpmn:sequenceFlow id="F_12" sourceRef="m1" targetRef="g5"/>
    <bpmn:sequenceFlow id="F_13" sourceRef="g5" targetRef="k1"/>
    <bpmn:sequenceFlow id="F_14" sourceRef="k1" targetRef="k2"/>
    <bpmn:sequenceFlow id="F_15" sourceRef="k2" targetRef="c4"/>
    <bpmn:sequenceFlow id="F_16" sourceRef="c4" targetRef="s2"/>
    <bpmn:sequenceFlow id="F_17" sourceRef="s2" targetRef="e"/>
  </bpmn:process>
