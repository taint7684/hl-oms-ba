      <bpmndi:BPMNShape id="S_Lane_BP3_ToBe_S" bpmnElement="Lane_BP3_ToBe_S" isHorizontal="true"><dc:Bounds x="64" y="365" width="2284" height="120"/></bpmndi:BPMNShape>
