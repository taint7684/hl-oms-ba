      <bpmndi:BPMNShape id="S_c1" bpmnElement="c1"><dc:Bounds x="1165" y="609" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_e2" bpmnElement="e2"><dc:Bounds x="1355" y="622" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_b1" bpmnElement="b1"><dc:Bounds x="1315" y="394" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_b2" bpmnElement="b2"><dc:Bounds x="1465" y="394" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g4" bpmnElement="g4" isMarkerVisible="true"><dc:Bounds x="1650" y="402" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_b3" bpmnElement="b3"><dc:Bounds x="1765" y="394" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_e1" bpmnElement="e1"><dc:Bounds x="1955" y="407" width="36" height="36"/></bpmndi:BPMNShape>
