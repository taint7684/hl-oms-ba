      <bpmndi:BPMNShape id="S_w4" bpmnElement="w4"><dc:Bounds x="1915" y="179" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_0" bpmnElement="F_0"><di:waypoint x="191" y="90"/><di:waypoint x="265" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_1" bpmnElement="F_1"><di:waypoint x="381" y="90"/><di:waypoint x="397" y="90"/><di:waypoint x="397" y="210"/><di:waypoint x="415" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_2" bpmnElement="F_2"><di:waypoint x="531" y="210"/><di:waypoint x="600" y="210"/></bpmndi:BPMNEdge>
