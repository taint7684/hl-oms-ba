      <bpmndi:BPMNShape id="S_g2" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="900" y="187" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g3" bpmnElement="g3"><dc:Bounds x="1050" y="187" width="46" height="46"/></bpmndi:BPMNShape>
