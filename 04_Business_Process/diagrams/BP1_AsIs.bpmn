<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP1_AsIs" targetNamespace="https://github.com/taint7684/hl-oms-ba">
  <bpmn:collaboration id="Col_BP1_AsIs">
    <bpmn:participant id="Pool_BP1_AsIs" name="BP1 As-Is · Gọi món tại bàn (phiếu giấy)" processRef="BP1_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="BP1_AsIs" isExecutable="false">
    <bpmn:laneSet id="LS_BP1_AsIs">
      <bpmn:lane id="Lane_BP1_AsIs_K" name="Khách">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP1_AsIs_W" name="Phục vụ">
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP1_AsIs_B" name="Bếp">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP1_AsIs_C" name="Thu ngân">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách ngồi vào bàn"><bpmn:outgoing>F_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="k1" name="Gọi món"><bpmn:incoming>F_0</bpmn:incoming><bpmn:incoming>F_17</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="w1" name="Ghi phiếu giấy 2 liên"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Khách có dị ứng?"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="w2" name="Ghi chú ở lề phiếu"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>F_4</bpmn:incoming><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="g3" name=""><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing><bpmn:outgoing>F_8</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="w3" name="Mang liên 1 vào bếp (2–3 phút)"><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="c1" name="Kẹp liên 2 chờ tính bill"><bpmn:incoming>F_8</bpmn:incoming><bpmn:outgoing>F_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e2" name="Chờ thanh toán (BP3)"><bpmn:incoming>F_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="b1" name="Phiếu chờ trên móc (TB 3 phút)"><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="b2" name="Bếp trưởng đọc to, chia trạm"><bpmn:incoming>F_11</bpmn:incoming><bpmn:outgoing>F_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="Còn món?"><bpmn:incoming>F_12</bpmn:incoming><bpmn:outgoing>F_13</bpmn:outgoing><bpmn:outgoing>F_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="b3" name="Chế biến"><bpmn:incoming>F_13</bpmn:incoming><bpmn:outgoing>F_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e1" name="Sang BP2"><bpmn:incoming>F_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="b4" name="Báo miệng cho phục vụ"><bpmn:incoming>F_14</bpmn:incoming><bpmn:outgoing>F_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="w4" name="Báo khách chọn món khác"><bpmn:incoming>F_16</bpmn:incoming><bpmn:outgoing>F_17</bpmn:outgoing></bpmn:userTask>
    <bpmn:sequenceFlow id="F_0" sourceRef="s" targetRef="k1"/>
    <bpmn:sequenceFlow id="F_1" sourceRef="k1" targetRef="w1"/>
    <bpmn:sequenceFlow id="F_2" sourceRef="w1" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_3" sourceRef="g1" targetRef="w2" name="Có"/>
    <bpmn:sequenceFlow id="F_4" sourceRef="g1" targetRef="g2" name="Không"/>
    <bpmn:sequenceFlow id="F_5" sourceRef="w2" targetRef="g2"/>
    <bpmn:sequenceFlow id="F_6" sourceRef="g2" targetRef="g3"/>
    <bpmn:sequenceFlow id="F_7" sourceRef="g3" targetRef="w3"/>
    <bpmn:sequenceFlow id="F_8" sourceRef="g3" targetRef="c1"/>
    <bpmn:sequenceFlow id="F_9" sourceRef="c1" targetRef="e2"/>
    <bpmn:sequenceFlow id="F_10" sourceRef="w3" targetRef="b1"/>
    <bpmn:sequenceFlow id="F_11" sourceRef="b1" targetRef="b2"/>
    <bpmn:sequenceFlow id="F_12" sourceRef="b2" targetRef="g4"/>
    <bpmn:sequenceFlow id="F_13" sourceRef="g4" targetRef="b3" name="Còn"/>
    <bpmn:sequenceFlow id="F_14" sourceRef="g4" targetRef="b4" name="Hết"/>
    <bpmn:sequenceFlow id="F_15" sourceRef="b3" targetRef="e1"/>
    <bpmn:sequenceFlow id="F_16" sourceRef="b4" targetRef="w4"/>
    <bpmn:sequenceFlow id="F_17" sourceRef="w4" targetRef="k1" name="Gọi lại"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_BP1_AsIs">
    <bpmndi:BPMNPlane id="Pl_BP1_AsIs" bpmnElement="Col_BP1_AsIs">
      <bpmndi:BPMNShape id="S_Pool_BP1_AsIs" bpmnElement="Pool_BP1_AsIs" isHorizontal="true"><dc:Bounds x="30" y="30" width="2018" height="670"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_AsIs_K" bpmnElement="Lane_BP1_AsIs_K" isHorizontal="true"><dc:Bounds x="64" y="30" width="1984" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_AsIs_W" bpmnElement="Lane_BP1_AsIs_W" isHorizontal="true"><dc:Bounds x="64" y="150" width="1984" height="215"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_AsIs_B" bpmnElement="Lane_BP1_AsIs_B" isHorizontal="true"><dc:Bounds x="64" y="365" width="1984" height="215"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_BP1_AsIs_C" bpmnElement="Lane_BP1_AsIs_C" isHorizontal="true"><dc:Bounds x="64" y="580" width="1984" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="155" y="72" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_k1" bpmnElement="k1"><dc:Bounds x="265" y="59" width="116" height="62"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_w1" bpmnElement="w1"><dc:Bounds x="415" y="179" width="116" height="62"/></bpmndi:BPMNShape>
