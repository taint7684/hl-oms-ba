<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BP2_ToBe" targetNamespace="https://github.com/taint7684/hl-oms-ba">
  <bpmn:collaboration id="Col_BP2_ToBe">
    <bpmn:participant id="Pool_BP2_ToBe" name="BP2 To-Be · Chế biến và lên món" processRef="BP2_ToBe"/>
  </bpmn:collaboration>
  <bpmn:process id="BP2_ToBe" isExecutable="false">
    <bpmn:laneSet id="LS_BP2_ToBe">
      <bpmn:lane id="Lane_BP2_ToBe_B" name="Bếp">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP2_ToBe_CH" name="Bếp trưởng">
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ch1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP2_ToBe_S" name="HL-OMS">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP2_ToBe_W" name="Phục vụ">
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP2_ToBe_K" name="Khách">
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Đơn tới trạm"><bpmn:outgoing>F_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="b1" name="Xem phiếu theo thứ tự thời gian"><bpmn:incoming>F_0</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Có dị ứng?"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing><bpmn:outgoing>F_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="b2" name="Đọc và xác nhận dị ứng (BR-04)"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>F_3</bpmn:incoming><bpmn:incoming>F_4</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="b3" name="Bắt đầu nấu"><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s1" name="Đếm thời gian, đổi màu khi quá ngưỡng (BR-06)"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Món trễ?"><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_8</bpmn:outgoing><bpmn:outgoing>F_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ch1" name="Ưu tiên, điều phối người"><bpmn:incoming>F_8</bpmn:incoming><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="b4" name="Bấm Sẵn sàng"><bpmn:incoming>F_9</bpmn:incoming><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s2" name="Thông báo phục vụ phụ trách bàn"><bpmn:incoming>F_11</bpmn:incoming><bpmn:outgoing>F_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="w1" name="Nhận thông báo, lấy món"><bpmn:incoming>F_12</bpmn:incoming><bpmn:outgoing>F_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="w2" name="Mang ra, xác nhận Đã phục vụ"><bpmn:incoming>F_13</bpmn:incoming><bpmn:outgoing>F_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="k1" name="Nhận món"><bpmn:incoming>F_14</bpmn:incoming><bpmn:outgoing>F_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e" name="Món đã lên bàn"><bpmn:incoming>F_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_0" sourceRef="s" targetRef="b1"/>
    <bpmn:sequenceFlow id="F_1" sourceRef="b1" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_2" sourceRef="g1" targetRef="b2" name="Có"/>
    <bpmn:sequenceFlow id="F_3" sourceRef="g1" targetRef="g2" name="Không"/>
    <bpmn:sequenceFlow id="F_4" sourceRef="b2" targetRef="g2"/>
    <bpmn:sequenceFlow id="F_5" sourceRef="g2" targetRef="b3"/>
    <bpmn:sequenceFlow id="F_6" sourceRef="b3" targetRef="s1"/>
    <bpmn:sequenceFlow id="F_7" sourceRef="s1" targetRef="g3"/>
    <bpmn:sequenceFlow id="F_8" sourceRef="g3" targetRef="ch1" name="Có"/>
    <bpmn:sequenceFlow id="F_9" sourceRef="g3" targetRef="b4" name="Không"/>
    <bpmn:sequenceFlow id="F_10" sourceRef="ch1" targetRef="b4"/>
    <bpmn:sequenceFlow id="F_11" sourceRef="b4" targetRef="s2"/>
    <bpmn:sequenceFlow id="F_12" sourceRef="s2" targetRef="w1"/>
    <bpmn:sequenceFlow id="F_13" sourceRef="w1" targetRef="w2"/>
    <bpmn:sequenceFlow id="F_14" sourceRef="w2" targetRef="k1"/>
    <bpmn:sequenceFlow id="F_15" sourceRef="k1" targetRef="e"/>
  </bpmn:process>
